{
  "name": "run-chart-goallimits",
  "version": "1.0.3",
  "description": "Professional run chart visualization tool for statistical process control and quality analysis",
  "author": "Aether Forge",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:store": "vite build --mode store",
    "package:store": "npm run build:store",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:pack-win": "npm run build && electron-builder --win",
    "electron:pack-msix": "npm run build && electron-builder --win --config.win.target=msix"
  },
  "dependencies": {
    "chart.js": "^4.3.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "vite-plugin-pwa": "^1.0.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/core": "^7.4.2",
    "@capacitor/filesystem": "^7.1.2",
    "@capacitor/share": "^7.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "vite": "^6.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.aetherforge.runchartvisualization",
    "productName": "Run Chart Visualization",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/Assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "appx",
          "arch": ["x64", "ia32", "arm64"]
        }
      ],
      "icon": "store-assets/icons/icon-256.png",
      "verifyUpdateCodeSignature": false
    },
    "appx": {
      "displayName": "Run Chart Visualization",
      "publisher": "CN=80415444-5392-4904-8AC7-7511A51DFC7C",
      "publisherDisplayName": "Aether Forge",
      "identityName": "AetherForge.RunChartVisualization",
      "backgroundColor": "#1e3a8a",
      "languages": ["en-US"],
      "showNameOnTiles": true,
      "setBuildNumber": true,
      "applicationId": "RunChartVisualization",
      "addAutoLaunchExtension": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Run Chart Visualization"
    }
  }
}
